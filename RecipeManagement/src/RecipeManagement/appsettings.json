{
  "AllowedHosts": "*",
  "RecipeManagement": {
    "ConnectionStrings": {
      "RecipeManagement": "Data Source=${DB_HOST:-localhost},${RECIPEMANAGEMENT_DB_PORT:-50734};Integrated Security=False;Database=${DB_NAME:-dev_recipemanagement};User ID=${DB_USER:-SA};Password=${SA_PASSWORD:-STRONGpassword777$!};Encrypt=True;TrustServerCertificate=true"
    },
    "Auth": {
      "Audience": "${KEYCLOAK_AUDIENCE:-recipe_management}",
      "Authority": "http://${KEYCLOAK_HOST:-localhost}:${KEYCLOAK_PORT:-3255}/realms/${KEYCLOAK_REALM_NAME:-DevRealm}",
      "AuthorizationUrl": "http://${KEYCLOAK_HOST:-localhost}:${KEYCLOAK_PORT:-3255}/realms/${KEYCLOAK_REALM_NAME:-DevRealm}/protocol/openid-connect/auth",
      "TokenUrl": "http://${KEYCLOAK_HOST:-localhost}:${KEYCLOAK_PORT:-3255}/realms/${KEYCLOAK_REALM_NAME:-DevRealm}/protocol/openid-connect/token",
      "ClientId": "${SWAGGER_CLIENT_ID:-recipe_management.swagger}",
      "ClientSecret": "${SWAGGER_CLIENT_SECRET:-974d6f71-d41b-4601-9a7a-a33081f80687}"
    },
    "RabbitMq": {
      "Host": "${RABBITMQ_HOST:-localhost}",
      "VirtualHost": "${RABBITMQ_VHOST:-/}",
      "Username": "${RABBITMQ_USER:-guest}",
      "Password": "${RABBITMQ_PASSWORD:-guest}",
      "Port": "${RABBITMQ_PORT:-50737}"
    },
    "JaegerHost": "${JAEGER_HOST:-localhost}",
    "CloudinaryUrl": "${CLOUDINARY_URL:-cloudinary://test@recipe-management}"
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Hangfire": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ]
  }
}